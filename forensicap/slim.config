# ForensicAP slim overlay — subsystem exclusions
#
# Applied between bcmXXXX_defconfig and the variant-specific overlay
# (v8.config / v8-16k.config).  Disables drivers and subsystems that
# are not needed on a headless wireless-analysis appliance.
# See forensicap/README.md for the full overlay layering order.


# ── WiFi: in-kernel chipset drivers ──────────────────────────────────────────
#
# DKMS packages (e.g. rtl88xxau from the aircrack-ng fork) provide reliable
# monitor mode and packet injection for the adapters used by ForensicAP.
# The in-kernel variants conflict with those DKMS drivers and often lack full
# monitor-mode / injection support.
#
# CFG80211, MAC80211, and RFKILL are kept: they are the framework that DKMS
# drivers register against.  BRCMFMAC is kept for the onboard Pi WiFi chip.
CONFIG_RTL8XXXU=n
CONFIG_RTW88=n
CONFIG_RTW89=n
CONFIG_RT2X00=n
CONFIG_MT7921U=n
CONFIG_MT7925U=n
CONFIG_MWIFIEX=n
CONFIG_IWLWIFI=n
CONFIG_ATH9K=n
CONFIG_ATH9K_HTC=n
CONFIG_ATH10K=n
CONFIG_ZD1211RW=n
CONFIG_LIBERTAS=n
CONFIG_MAC80211_HWSIM=n


# ── Printers ──────────────────────────────────────────────────────────────────
CONFIG_USB_PRINTER=n
CONFIG_USB_G_PRINTER=n
CONFIG_USB_CONFIGFS_F_PRINTER=n
CONFIG_NF_CONNTRACK_SANE=n


# ── Scanners ──────────────────────────────────────────────────────────────────
CONFIG_USB_MICROTEK=n
CONFIG_USB_MDC800=n


# ── Sound / Audio ─────────────────────────────────────────────────────────────
# Disables ALSA core, OSS emulation, USB audio, all I2S/PCM drivers, and all
# audio HATs (HiFiBerry, IQAudio, JustBoom, Allo, AudioInjector, PiFi-40).
CONFIG_SOUND=n


# ── Display / GPU acceleration ────────────────────────────────────────────────
# Headless appliance — no display output needed.  The simple framebuffer
# (FB_BCM2708 / FB_SIMPLE) is retained for serial-console access.
CONFIG_DRM_VC4=n
CONFIG_DRM_V3D=n
CONFIG_DRM_RP1_DSI=n
CONFIG_DRM_RP1_DPI=n
CONFIG_DRM_RP1_VEC=n
CONFIG_DRM_PANEL_SIMPLE=n
CONFIG_FB_TFT=n
CONFIG_FB_SSD1307=n


# ── Camera sensors and USB video capture ─────────────────────────────────────
# MEDIA_SUPPORT, DVB_USB_V2, and DVB_USB_RTL28XXU are kept — RTL-SDR depends
# on the DVB-USB framework.  Only V4L2 capture and camera-sensor drivers that
# serve no purpose on ForensicAP are removed.
CONFIG_USB_VIDEO_CLASS=n
CONFIG_USB_GSPCA=n
CONFIG_VIDEO_PVRUSB2=n
CONFIG_VIDEO_HDPVR=n
CONFIG_VIDEO_GO7007=n
CONFIG_VIDEO_STK1160=n
CONFIG_VIDEO_AU0828=n
CONFIG_VIDEO_USBTV=n
CONFIG_VIDEO_VIVID=n
CONFIG_VIDEO_BCM2835_UNICAM=n
CONFIG_VIDEO_BCM2835_UNICAM_LEGACY=n
CONFIG_VIDEO_RPI_HEVC_DEC=n
CONFIG_VIDEO_RASPBERRYPI_PISP_BE=n
CONFIG_VIDEO_RP1_CFE=n
CONFIG_VIDEO_IMX219=n
CONFIG_VIDEO_IMX258=n
CONFIG_VIDEO_IMX290=n
CONFIG_VIDEO_IMX477=n
CONFIG_VIDEO_IMX708=n
CONFIG_VIDEO_OV5647=n
CONFIG_VIDEO_OV7251=n
CONFIG_VIDEO_OV9282=n


# ── Tape and optical drives ───────────────────────────────────────────────────
CONFIG_CHR_DEV_ST=n
CONFIG_BLK_DEV_SR=n


# ── Amateur radio ─────────────────────────────────────────────────────────────
# Disabling HAMRADIO cascades to AX25, NETROM, and ROSE.
CONFIG_HAMRADIO=n


# ── CAN bus ───────────────────────────────────────────────────────────────────
# Disabling CAN cascades to all controller drivers (MCP251X, Peak, GS_USB …).
CONFIG_CAN=n


# ── Exotic / cluster filesystems ─────────────────────────────────────────────
# Keep: ext4, f2fs, btrfs, xfs, vfat, exfat, ntfs3 (forensic evidence media).
CONFIG_JFS_FS=n
CONFIG_REISERFS_FS=n
CONFIG_NILFS2_FS=n
CONFIG_GFS2_FS=n
CONFIG_OCFS2_FS=n
