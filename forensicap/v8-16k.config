# ForensicAP kernel config overlay — rpi-2712 variant (Pi 5 / CM5, 16k pages).
#
# Applied via scripts/kconfig/merge_config.sh on top of bcm2712_defconfig.
# Mirrors the rpi-v8 overlay — regdb and LOCALVERSION tweaks are not
# arch-variant-specific.  Kept as a separate file so future Pi-5-only tweaks
# can land here without touching the rpi-v8 build.
# See forensicap/README.md for the full build invocation.

# ── Unsigned regulatory database ─────────────────────────────────────────────
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=n

# ── Identifiable build string ────────────────────────────────────────────────
# CRITICAL: merge_config.sh REPLACES the bcm2712_defconfig value of "-v8-16k"
# rather than appending to it (Kconfig has no string-append operation).  We
# therefore hardcode the full suffix including "-v8-16k" so the resulting
# kver matches what consumers expect and so rpi-2712 builds produce a deb
# distinct from rpi-v8.  uname -r will read "6.12.<minor>-v8-16k-forensicap".
CONFIG_LOCALVERSION="-v8-16k-forensicap"

# See v8.config for the rationale on LOCALVERSION_AUTO + .scmversion handling.
CONFIG_LOCALVERSION_AUTO=n
